{{ header }}
    <section class="thanks co-retry">
        <div class="container">
            <div class="thanks__inner">
                <h1 class="thanks__title">{{ heading_title }}</h1>
                <p class="co-retry__text">{{ text_message }}</p>
                <p class="co-retry__order">{{ text_order_number }}{{ order_id }} {{ text_order_amount }} <strong>{{ order_total }}</strong></p>
                <div class="co-retry__actions">
                    <button type="button" class="thanks__btn btn-4" data-retry-pay>{{ button_retry_payment }}</button>
                    <a class="thanks__btn btn" href="{{ continue }}">{{ text_home }}</a>
                </div>
                <p class="co-retry__contacts">{{ text_questions }}
                    {% if store_email %}<a href="mailto:{{ store_email }}">{{ store_email }}</a>{% endif %}
                    {% if store_telephone %} · <a href="{{ store_telephone_link }}">{{ store_telephone }}</a>{% endif %}
                </p>
            </div>
            <div hidden>{{ payment }}</div>
        </div>
    </section>
<style>
.co-retry__text { max-width: 560px; margin: 16px auto 0; font-size: 16px; line-height: 1.5; text-align: center; }
.co-retry__order { margin-top: 16px; font-size: 16px; text-align: center; }
.co-retry__actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 24px; }
.co-retry__actions .thanks__btn { min-height: 50px; margin-top: 0; }
.co-retry__contacts { margin-top: 24px; font-size: 14px; text-align: center; }
.co-retry__contacts a { text-decoration: underline; }
</style>
<script>
/* retry the payment of the same order: register the intent, then submit the WayForPay form */
(function () {
    var btn = document.querySelector('[data-retry-pay]');
    if (!btn) return;

    btn.addEventListener('click', function () {
        btn.disabled = true;

        fetch('index.php?route=extension/payment/wayforpay/confirm', { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function () {
                var form = document.getElementById('wayforpay_submit');
                if (form) { form.submit(); } else { btn.disabled = false; }
            })
            .catch(function () { btn.disabled = false; });
    });
})();
</script>
{{ footer }}

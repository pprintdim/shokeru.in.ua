{{ header }}
{{ content_top }}
<section class="order co">
    <div class="container">
        <ul class="breadcrumbs">
            {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}"{% if loop.last %} class="active"{% endif %}>{{ breadcrumb.text }}</a></li>
            {% endfor %}
        </ul>

        {% if error_warning %}<div class="co-alert" role="alert">{{ error_warning }}</div>{% endif %}

        <form class="order__inner co-form" data-checkout-form data-base="{{ base }}" novalidate autocomplete="on">
            <script type="application/json" data-checkout-config>{"logged":{{ logged ? 'true' : 'false' }},"shippingRequired":{{ shipping_required ? 'true' : 'false' }},"destinationTypes":{{ destination_types|raw }},"pickup":{"city":{{ co_text_pickup_city|json_encode|raw }},"address":{{ (co_text_pickup_prefix ~ pickup_address_line)|json_encode|raw }}},"text":{"shipping":{{ co_error_shipping|json_encode|raw }},"payment":{{ co_error_payment|json_encode|raw }},"city":{{ co_error_city|json_encode|raw }},"cityFirst":{{ co_text_city_first|json_encode|raw }},"notFound":{{ co_text_not_found|json_encode|raw }},"failed":{{ co_error_failed|json_encode|raw }},"destReset":{{ co_text_dest_reset|json_encode|raw }}},"success":{{ success|json_encode|raw }},"countryId":"{{ country_id }}","zoneId":"{{ zone_id }}"}</script>

            <div class="order__left">
                <h1 class="order__title">{{ heading_title }}</h1>
                <p class="co-lead">{{ co_text_lead }}</p>

                <div class="order__form">
                    {# 1. Contacts #}
                    <div class="order__form-box">
                        <div class="order__form-top">
                            <p class="order__form-num">1</p>
                            <h3 class="order__form-title">{{ co_text_contacts }}</h3>
                        </div>
                        {% if logged %}
                            <p class="co-note">{{ co_text_logged_as }} <strong>{{ customer_email }}</strong></p>
                        {% else %}
                            <p class="co-note">{{ co_text_login_hint }} <a href="{{ login }}" data-co-login data-auth-open="login">{{ co_text_login_link }}</a></p>
                        {% endif %}
                        <div class="checkout-grid co-grid">
                            <div class="checkout-field">
                                <label class="co-label co-label--req" for="co-firstname">{{ co_entry_firstname }}</label>
                                <input class="co-input" id="co-firstname" type="text" name="firstname" value="{{ customer_firstname }}" required autocomplete="given-name" placeholder="{{ co_entry_firstname }}" data-required="{{ co_error_firstname }}">
                            </div>
                            <div class="checkout-field">
                                <label class="co-label co-label--req" for="co-lastname">{{ co_entry_lastname }}</label>
                                <input class="co-input" id="co-lastname" type="text" name="lastname" value="{{ customer_lastname }}" required autocomplete="family-name" placeholder="{{ co_entry_lastname }}" data-required="{{ co_error_lastname }}">
                            </div>
                            <div class="checkout-field">
                                <label class="co-label co-label--req" for="co-telephone">{{ co_entry_telephone }}</label>
                                <input class="co-input" id="co-telephone" type="tel" name="telephone" value="{{ customer_telephone }}" required autocomplete="tel" inputmode="tel" data-required="{{ co_error_telephone }}" data-phone-input>
                            </div>
                            <div class="checkout-field">
                                <label class="co-label co-label--req" for="co-email">{{ co_entry_email }}</label>
                                <input class="co-input" id="co-email" type="email" name="email" value="{{ customer_email }}" required autocomplete="email" placeholder="name@example.com" data-required="{{ co_error_email }}"{% if logged %} readonly{% endif %}>
                            </div>
                        </div>
                    </div>

                    {# 2. Delivery #}
                    {% if shipping_required %}
                    <div class="order__form-box">
                        <div class="order__form-top">
                            <p class="order__form-num">2</p>
                            <h3 class="order__form-title">{{ co_text_delivery }}</h3>
                        </div>
                        {% if shipping_options %}
                        <div class="co-stack">
                            <div class="checkout-field">
                                <label class="co-label co-label--req" for="co-shipping">{{ co_entry_shipping }}</label>
                                <select class="co-input co-select" id="co-shipping" name="shipping_option" data-shipping-select>
                                    {% for option in shipping_options %}
                                        <option value="{{ loop.index0 }}" data-code="{{ option.code }}" data-receive="{{ option.receive }}">{{ option.title }}{% if option.cost %} ({{ option.cost }}){% endif %}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <p class="co-pickup" data-pickup-info hidden>{{ co_text_pickup_info }}<strong>{{ pickup_address }}</strong>{% if pickup_hours %}<span>{{ pickup_hours }}</span>{% endif %}</p>
                            <div class="checkout-grid co-grid">
                                <div class="checkout-field" data-destination-block>
                                    <label class="co-label co-label--req" for="co-city">{{ co_entry_city }}</label>
                                    <div class="co-suggest">
                                        <input class="co-input" id="co-city" type="text" name="city" value="{{ default_city }}" autocomplete="off" placeholder="{{ co_entry_city }}" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="co-city-list" data-city>
                                        <ul class="co-suggest__list" id="co-city-list" role="listbox" data-city-list hidden></ul>
                                    </div>
                                </div>
                                <div class="checkout-field" data-destination-block>
                                    <label class="co-label co-label--req" for="co-destination" data-destination-label>{{ co_entry_branch }}</label>
                                    <div class="co-suggest">
                                        <input class="co-input" id="co-destination" type="text" name="destination" value="{{ default_address }}" autocomplete="off" placeholder="{{ co_entry_branch }}" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="co-destination-list" data-destination data-receive-type="branch">
                                        <ul class="co-suggest__list" id="co-destination-list" role="listbox" data-destination-list hidden></ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% else %}
                            <p class="co-note">{{ co_text_no_shipping }}</p>
                        {% endif %}
                    </div>
                    {% endif %}

                    {# 3. Payment #}
                    <div class="order__form-box">
                        <div class="order__form-top">
                            <p class="order__form-num">{{ shipping_required ? 3 : 2 }}</p>
                            <h3 class="order__form-title">{{ co_text_payment }}</h3>
                        </div>
                        {% if payment_methods %}
                            <div class="co-choices" role="radiogroup" aria-label="{{ co_entry_payment }}">
                                {% for method in payment_methods %}
                                    <label class="checkbox-block co-choice">
                                        <input type="radio" name="payment_method" value="{{ method.code }}" class="visually-hidden"{% if loop.first %} checked{% endif %}>
                                        <span>{{ method.title }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="co-note">{{ co_text_no_payment }}</p>
                        {% endif %}
                        <div class="checkout-field co-comment">
                            <label class="co-label" for="co-comment">{{ co_entry_comment }}</label>
                            <textarea class="co-input" id="co-comment" name="comment" rows="4" placeholder="{{ co_entry_comment }}"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <span class="order__line"></span>

            <div class="order__right">
                <div class="order__info co-summary">
                    <h2 class="co-summary__title">{{ co_text_your_order }}</h2>
                    <div class="co-lines">
                        {% for product in summary_products %}
                            <div class="co-line">
                                <a class="co-line__thumb" href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" width="64" height="64" loading="lazy"></a>
                                <div class="co-line__body">
                                    <a class="co-line__name" href="{{ product.href }}">{{ product.name }}</a>
                                    <span class="co-line__meta">{{ product.quantity }} &times; {{ product.price }}</span>
                                    {% for option in product.options %}<span class="co-line__meta">{{ option }}</span>{% endfor %}
                                </div>
                                <span class="co-line__sum">{{ product.total }}</span>
                            </div>
                        {% endfor %}
                        {% for voucher in summary_vouchers %}
                            <div class="co-line co-line--plain">
                                <span class="co-line__name">{{ voucher.description }}</span>
                                <span class="co-line__sum">{{ voucher.amount }}</span>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="order__info-block co-totals">
                        {% for total in summary_totals %}
                            {% if loop.last %}
                                <div class="order__info-item co-totals__grand">
                                    <p class="order__info-name">{{ total.title }}</p>
                                    <p class="order__info-name">{{ total.text }}</p>
                                </div>
                            {% elseif total.code != 'sub_total' or summary_totals|length > 2 %}
                                <div class="order__info-item">
                                    <p class="order__info-descr">{{ total.title }}</p>
                                    <p class="order__info-descr">{{ total.text }}</p>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <p class="co-error" data-checkout-error role="alert" hidden></p>
                    <button type="submit" class="order__info-send btn-4 co-submit" data-checkout-submit data-loading-text="{{ co_text_sending }}"{% if (shipping_required and not shipping_options) or not payment_methods %} disabled{% endif %}>{{ co_button_place_order }}</button>
                    <p class="co-consent">{{ co_text_consent }}</p>
                    <a href="{{ cart }}" class="co-back">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                        {{ co_text_back_to_cart }}
                    </a>
                </div>
            </div>
        </form>
    </div>
</section>
<div class="checkout-loader" data-checkout-loader aria-live="polite" hidden>
    <div class="checkout-loader__panel">
        <span class="checkout-loader__ring"></span>
        <img class="checkout-loader__logo" src="image/catalog/logo.svg" alt="">
    </div>
</div>
{{ content_bottom }}
<script>
/* GA4 begin_checkout: ga4.js pushes it to dataLayer (GTM); gtag gets it directly when present */
window.ShokeruGA4Checkout = {{ ga4_checkout|raw }};
if (typeof window.gtag === 'function') { window.gtag('event', 'begin_checkout', window.ShokeruGA4Checkout); }
</script>
{{ footer }}

<section class="faq">
    <div class="container">
        <div class="faq__inner">
            {% if heading or heading_accent %}
                <h2 class="faq__title title">{{ heading }}<span>{{ heading_accent }}</span></h2>
            {% endif %}
            <div class="faq__block">
                {% for item in items %}
                    <div class="faq__item">
                        <h3 class="faq__item-title">{{ item.question }}</h3>
                        <div class="faq__item-content">
                            {{ item.content|raw }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
{% if items %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in items %}{"@type":"Question","name":"{{ item.question|e('js') }}","acceptedAnswer":{"@type":"Answer","text":"{{ item.content|striptags|e('js') }}"}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}

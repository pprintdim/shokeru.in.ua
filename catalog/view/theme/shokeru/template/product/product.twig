<script>
function prodToggle(item, open) {
    document.querySelectorAll('.prod__item').forEach(i => {
        i.classList.remove('active');
        const t = i.querySelector('.prod__item-title');
        if (t) t.setAttribute('aria-expanded', 'false');
    });
    if (open) {
        item.classList.add('active');
        const t = item.querySelector('.prod__item-title');
        if (t) t.setAttribute('aria-expanded', 'true');
    }
}
function prodScrollTo(item) {
    window.scrollTo({ top: item.getBoundingClientRect().top + window.scrollY - 90, behavior: 'smooth' });
}
document.querySelectorAll('.prod__item-title').forEach(title => {
    const handler = () => {
        const currentItem = title.closest('.prod__item');
        const isActive = currentItem.classList.contains('active');
        prodToggle(currentItem, !isActive);
        if (!isActive && window.innerWidth < 1000) prodScrollTo(currentItem);
    };
    title.addEventListener('click', handler);
    title.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); handler(); }
    });
});
document.querySelectorAll('[data-prod-anchor]').forEach(a => {
    a.addEventListener('click', e => {
        e.preventDefault();
        const item = document.getElementById(a.dataset.prodAnchor);
        if (!item) return;
        prodToggle(item, true);
        prodScrollTo(item);
    });
});


// Swiper підключається у футері (addScript) — ініціалізуємо, коли він уже є
document.addEventListener('DOMContentLoaded', function () {
if (typeof Swiper === 'undefined') return;
const thumbsSwiper = new Swiper('.prod__thumbs', {
    direction: 'vertical',
    slidesPerView: 'auto',
    spaceBetween: 24,
    watchSlidesProgress: true,
    simulateTouch: true,
    grabCursor: true,
    mousewheel: true, // дозволяє скрол на трекпаді
});

const mainSwiper = new Swiper('.prod__slider-inner', {
    slidesPerView: 1,
    mousewheel: { forceToAxis: true, thresholdDelta: 10, releaseOnEdges: true }, // гортання трекпадом
    spaceBetween: 16,
    simulateTouch: true,
    grabCursor: true,
    navigation: {
      nextEl: '.prod__slider-next',
      prevEl: '.prod__slider-prev',
    },
    pagination: { el: '.prod__dots', clickable: true },
    thumbs: {
      swiper: thumbsSwiper,
    },
    breakpoints: {
        1280: {
            spaceBetween: 24,
            slidesPerView: 2,
        },
    },
});
});

   


</script>
{{ content_bottom }}
{{ footer }}


<script>
document.addEventListener('DOMContentLoaded', () => {
    const quantityInput = document.querySelector('.prod__about-quantity .quantity-count');
    const quantityMinus = document.querySelector('.prod__about-quantity .quantity-minus');
    const quantityPlus = document.querySelector('.prod__about-quantity .quantity-plus');
    const addButton = document.querySelector('.prod__add[data-product-id]');

    const normalizeQuantity = () => {
        if (!quantityInput) {
            return 1;
        }

        const min = parseInt(quantityInput.getAttribute('min'), 10) || 1;
        const max = parseInt(quantityInput.getAttribute('max'), 10) || 999;
        let value = parseInt(quantityInput.value, 10);

        if (Number.isNaN(value) || value < min) {
            value = min;
        }

        if (value > max) {
            value = max;
        }

        quantityInput.value = value;

        return value;
    };

    if (quantityMinus && quantityInput) {
        quantityMinus.addEventListener('click', () => {
            quantityInput.value = normalizeQuantity() - 1;
            normalizeQuantity();
        });
    }

    if (quantityPlus && quantityInput) {
        quantityPlus.addEventListener('click', () => {
            quantityInput.value = normalizeQuantity() + 1;
            normalizeQuantity();
        });
    }

    if (quantityInput) {
        quantityInput.addEventListener('change', normalizeQuantity);
    }

    if (addButton) {
        addButton.addEventListener('click', () => {
            const productId = addButton.dataset.productId;
            const quantity = normalizeQuantity();

            if (window.cart && typeof window.cart.add === 'function') {
                window.cart.add(productId, quantity, () => {
                    if (window.ShokeruGA4 && typeof window.ShokeruGA4.trackAddToCartFromElement === 'function') {
                        window.ShokeruGA4.trackAddToCartFromElement(addButton, quantity);
                    }

                    window.openThemeCart();
                });
            }
        });
    }

    // стан «вже в кошику»: common.js шле cart:added після успішного додавання
    const cartStatus = document.querySelector('[data-cart-status]');
    const bar = document.querySelector('[data-purchase-bar]');
    const barBuy = document.querySelector('[data-pbar-buy]');
    const barInCart = document.querySelector('[data-pbar-incart]');

    document.addEventListener('cart:added', (e) => {
        const d = e.detail || {};

        if (!cartStatus || String(d.product_id) !== cartStatus.dataset.productId) return;

        const total = (parseInt(cartStatus.dataset.cartQty, 10) || 0) + (parseInt(d.quantity, 10) || 1);
        const text = cartStatus.querySelector('[data-cart-status-text]');

        cartStatus.dataset.cartQty = total;
        if (text) text.textContent = (cartStatus.dataset.template || '%s').replace('%s', total);
        cartStatus.hidden = false;

        if (barBuy && barInCart) {
            barBuy.hidden = true;
            barInCart.hidden = false;
        }
    });

    // липка панель покупки: «Купити» = клік по основній кнопці (кількість береться з поля)
    if (barBuy && addButton) {
        barBuy.addEventListener('click', () => addButton.click());
    }

    // зʼявляється, коли основна кнопка пішла вгору за екран; ховається біля футера
    if (bar && addButton) {
        const footer = document.querySelector('.footer');
        let barTicking = false;

        const syncBar = () => {
            const passed = addButton.getBoundingClientRect().bottom < 0;
            const nearFooter = footer ? footer.getBoundingClientRect().top < window.innerHeight : false;
            const visible = passed && !nearFooter;

            bar.classList.toggle('is-visible', visible);
            bar.setAttribute('aria-hidden', String(!visible));
            barTicking = false;
        };

        window.addEventListener('scroll', () => {
            if (!barTicking) { barTicking = true; requestAnimationFrame(syncBar); }
        }, { passive: true });
        window.addEventListener('resize', syncBar);
        syncBar();
    }
});

// відгуки: підвантаження списку і надсилання форми (стокові маршрути OpenCart)
(function () {
    var box = document.getElementById('review');
    if (!box) return;
    function load(page) {
        fetch('index.php?route=product/product/review&product_id={{ product_id }}&page=' + (page || 1), {headers: {'X-Requested-With': 'XMLHttpRequest'}})
            .then(function (r) { return r.text(); })
            .then(function (html) {
                box.innerHTML = html;
                box.querySelectorAll('.prod__reviews-pagination a').forEach(function (a) {
                    a.addEventListener('click', function (e) {
                        e.preventDefault();
                        var m = a.href.match(/page=(\d+)/);
                        load(m ? m[1] : 1);
                    });
                });
            });
    }
    load(1);
    // гість: відкриваємо попап входу; після входу/реєстрації повертаємось сюди до форми відгуку
    var reviewLogin = document.querySelector('[data-review-login]');
    if (reviewLogin) {
        reviewLogin.addEventListener('click', function () {
            var back = window.location.href.split('#')[0];
            back += (back.indexOf('?') > -1 ? '&' : '?') + 'review=1#form-review';
            document.querySelectorAll('[data-popup-redirect]').forEach(function (input) { input.value = back; });
            var popup = document.querySelector('.userPopup');
            if (popup) popup.classList.add('active');
        });
    }

    var btn = document.getElementById('button-review');
    if (btn) {
        btn.addEventListener('click', function () {
            var form = document.getElementById('form-review');
            btn.disabled = true;
            fetch('index.php?route=product/product/write&product_id={{ product_id }}', {
                method: 'POST',
                headers: {'X-Requested-With': 'XMLHttpRequest'},
                body: new FormData(form)
            })
                .then(function (r) { return r.json(); })
                .then(function (json) {
                    btn.disabled = false;
                    form.querySelectorAll('.prod__review-error').forEach(function (n) { n.remove(); });
                    if (json.error) {
                        Object.keys(json.error).forEach(function (k) {
                            var note = document.createElement('p');
                            note.className = 'prod__review-error';
                            note.textContent = json.error[k];
                            form.prepend(note);
                        });
                    }
                    if (json.success) {
                        form.reset();
                        var ok = document.createElement('p');
                        ok.className = 'prod__review-success';
                        ok.textContent = json.success;
                        form.prepend(ok);
                        load(1);
                    }
                })
                .catch(function () { btn.disabled = false; });
        });
    }
})();
</script>


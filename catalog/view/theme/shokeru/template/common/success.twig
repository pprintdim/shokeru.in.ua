{{ header }}
    <section class="thanks">
        <div class="container">
            <div class="thanks__inner">
                <h2 class="thanks__title">
                    {{ text_order_accepted }}
                    {% if order_id %}<br>{{ text_order_number }} №{{ order_id }}{% endif %}
                </h2>
                <a class="thanks__btn btn" href="{{ continue }}">
                    {{ button_home }}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M4.66602 12.0002L8.66602 8.00016L4.66602 4.00016L5.99935 2.66683L11.3327 8.00016L5.99935 13.3335L4.66602 12.0002Z" fill="#202222"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>
{% if ga4_purchase is defined and ga4_purchase %}
<script>
window.dataLayer = window.dataLayer || [];
window.ShokeruGA4Purchase = {{ ga4_purchase|raw }};
/* gtag (no GTM): send purchase directly, once per order; ga4.js covers dataLayer/GTM */
(function (order) {
    if (typeof window.gtag !== 'function' || !order || !order.transaction_id) return;
    var key = 'shokeru_gtag_purchase_' + order.transaction_id;
    try { if (sessionStorage.getItem(key)) return; sessionStorage.setItem(key, '1'); } catch (e) {}
    window.gtag('event', 'purchase', order);
})(window.ShokeruGA4Purchase);
</script>
{% endif %}
{{ footer }}

{% if languages|length > 0 %}
  <div class="header__lang">

    {# ПОТОЧНА МОВА #}
    <button type="button" class="header__lang-selected" aria-haspopup="true">
      {{ current.name|upper }}
    </button>

    {# ІНШІ МОВИ #}
    <div class="header__lang-content">
      {% for lang in languages %}
        <a href="index.php?route=common/language/set&code={{ lang.code }}" hreflang="{{ lang.code|split('-')|first }}" lang="{{ lang.code|split('-')|first }}">
          {{ lang.name|upper }}
        </a>
      {% endfor %}
    </div>

  </div>
{% endif %}

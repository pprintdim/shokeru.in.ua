<section class="userPopup">
    <div class="userPopup__image">
        <img src="catalog/view/theme/shokeru/images/userPopup.png" alt="">
    </div>
    <div class="container">
        <div class="userPopup__inner">
            <div class="userPopup__top">
            <a class="userPopup__logo" href="{{ name }}">
                <img src="{{ logo }}?v=20260626b" alt="" width="260" height="38">
            </a>
            <button class="userPopup__close">{{ text_close }}</button>
        </div>
        <div class="userPopup__bottom">
            <div class="userPopup__left">
                <div class="header__menu-bottom">
                    <div class="header__menu-block">
                        <div class="header__menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M22.0001 16.92V19.92C22.0012 20.1985 21.9441 20.4741 21.8326 20.7293C21.721 20.9845 21.5574 21.2136 21.3521 21.4018C21.1469 21.5901 20.9046 21.7335 20.6408 21.8227C20.377 21.9119 20.0974 21.945 19.8201 21.92C16.7429 21.5856 13.7871 20.5341 11.1901 18.85C8.77388 17.3146 6.72539 15.2661 5.19006 12.85C3.50003 10.2412 2.4483 7.27097 2.12006 4.17997C2.09507 3.90344 2.12793 3.62474 2.21656 3.3616C2.30518 3.09846 2.44763 2.85666 2.63482 2.6516C2.82202 2.44653 3.04986 2.28268 3.30385 2.1705C3.55783 2.05831 3.8324 2.00024 4.11006 1.99997H7.11006C7.59536 1.9952 8.06585 2.16705 8.43382 2.48351C8.80179 2.79996 9.04213 3.23942 9.11005 3.71997C9.23668 4.68004 9.47151 5.6227 9.81006 6.52997C9.9446 6.8879 9.97372 7.27689 9.89396 7.65086C9.81421 8.02482 9.62892 8.36809 9.36005 8.63998L8.09006 9.90997C9.51361 12.4135 11.5865 14.4864 14.0901 15.91L15.3601 14.64C15.6319 14.3711 15.9752 14.1858 16.3492 14.1061C16.7231 14.0263 17.1121 14.0554 17.4701 14.19C18.3773 14.5285 19.32 14.7634 20.2801 14.89C20.7658 14.9585 21.2095 15.2032 21.5266 15.5775C21.8437 15.9518 22.0122 16.4296 22.0001 16.92Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="header__menu-tel">
                            {% for phone in phones %}
                                   <a class="header__menu-link" href="{{ phone.href }}">{{ phone.label }}</a>
                                    {% if not loop.last %}
                                    <span> / </span>
                                  {% endif %}
                                {% endfor %}
                        </div>
                    </div>
                    <div class="header__menu-block">
                        <div class="header__menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M22 6L12 13L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <a class="header__menu-link" href="mailto:admin@trikobakh.com">{{ email }}</a>
                    </div>
                    <div class="header__menu-social">
                        <a href="#" target="_blank">
                            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 25 25" fill="none">
                                <path d="M18.2327 0H6.76727C3.03574 0 0 3.03574 0 6.76727V18.2329C0 21.9643 3.03574 25 6.76727 25H18.2329C21.9643 25 25 21.9643 25 18.2329V6.76727C25 3.03574 21.9643 0 18.2327 0ZM12.5 19.3357C8.7307 19.3357 5.66425 16.2693 5.66425 12.5C5.66425 8.7307 8.7307 5.66425 12.5 5.66425C16.2693 5.66425 19.3357 8.7307 19.3357 12.5C19.3357 16.2693 16.2693 19.3357 12.5 19.3357ZM19.4992 7.27634C18.3853 7.27634 17.4793 6.37035 17.4793 5.25646C17.4793 4.14257 18.3853 3.23639 19.4992 3.23639C20.6131 3.23639 21.5193 4.14257 21.5193 5.25646C21.5193 6.37035 20.6131 7.27634 19.4992 7.27634Z" fill="#D2D2D2"/>
                                <path d="M12.5 7C9.46743 7 7 9.46724 7 12.5C7 15.5326 9.46743 18 12.5 18C15.5328 18 18 15.5326 18 12.5C18 9.46724 15.5328 7 12.5 7Z" fill="#D2D2D2"/>
                            </svg>
                        </a>
                        <a href="#" target="_blank">
                            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 25 25" fill="none">
                                <path d="M21.3379 0H3.66211C1.64299 0 0 1.64299 0 3.66211V21.3379C0 23.357 1.64299 25 3.66211 25H11.0352V16.1621H8.10547V11.7676H11.0352V8.78906C11.0352 6.36578 13.0064 4.39453 15.4297 4.39453H19.873V8.78906H15.4297V11.7676H19.873L19.1406 16.1621H15.4297V25H21.3379C23.357 25 25 23.357 25 21.3379V3.66211C25 1.64299 23.357 0 21.3379 0Z" fill="#D2D2D2"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="userPopup__content">
                <div class="userPopup__select userPopup__select-login">
                    <button class="userPopup__btn active" data-userPopup-select="login">{{ button_login }}</button>
                    <button class="userPopup__btn" data-userPopup-select="register">{{ button_register }}</button>
                </div>

                {# ===== ЛОГІН (email + пароль) ===== #}
                <div class="userPopup__result active" data-userPopup-result="login">
                    <form id="popup-login-form" class="userPopup__form">
                        <input type="hidden" name="redirect" value="" data-popup-redirect>
                        <div class="userPopup__form-block">
                            <div class="userPopup__form-item">
                                <input type="email" name="email" class="userPopup__form-input" placeholder="Email*" required>
                            </div>
                            <div class="userPopup__form-item">
                                <button class="userPopup__form-show form-show-password" type="button"></button>
                                <input type="password" name="password" class="userPopup__form-input" placeholder="{{ text_password }}*" required>
                            </div>
                        </div>

                        <a class="userPopup__form-forgot" href="#">{{ text_forgot }}</a>

                        <div class="userPopup__form-error login-error" style="display:none;"></div>

                        <button type="submit" class="userPopup__form-btn btn">{{ button_login }}</button>

                        <div class="userPopup__form-more"><span></span> {{ text_or }} <span></span></div>

                        <div class="userPopup__form-buttons">
                            {% if google_client_id %}
                                <button type="button" class="userPopup__form-log btn-2" id="btn-google-login">{{ button_google }}</button>
                            {% else %}
                                <button type="button" class="userPopup__form-log btn-2" disabled title="{{ text_google_oauth_off }}">{{ button_google }}</button>
                            {% endif %}
                            {% if facebook_app_id %}
                                <button type="button" class="userPopup__form-log btn-2" id="btn-facebook-login">{{ button_facebook }}</button>
                            {% else %}
                                <button type="button" class="userPopup__form-log btn-2" disabled title="{{ text_fb_oauth_off }}">{{ button_facebook }}</button>
                            {% endif %}
                        </div>
                    </form>

                    <script>
                    (function() {
                        const form    = document.getElementById('popup-login-form');
                        const errorEl = form.querySelector('.login-error');
                        function showError(msg) { errorEl.textContent = msg; errorEl.style.display = 'block'; }
                        function clearError() { errorEl.textContent = ''; errorEl.style.display = 'none'; }
                        form.addEventListener('submit', function(event) {
                            event.preventDefault();
                            clearError();

                            fetch('index.php?route=common/user_popup/login', {
                                method: 'POST',
                                body: new FormData(form),
                                credentials: 'same-origin'
                            })
                            .then(function(r) { return r.json(); })
                            .then(function(json) {
                                if (json.success) window.location.href = json.redirect;
                                else showError(json.error || '{{ error_login }}');
                            })
                            .catch(function() { showError('Сталася помилка, спробуйте ще раз'); });
                        });

                        {% if google_client_id %}
                        // Google
                        window.handleGoogleCredential = function(response) {
                            fetch('index.php?route=common/user_popup/googleLogin', {
                                method: 'POST',
                                body: new URLSearchParams({ credential: response.credential }),
                                credentials: 'same-origin'
                            })
                            .then(function(r) { return r.json(); })
                            .then(function(json) {
                                if (json.success) window.location.href = json.redirect;
                                else showError(json.error || 'Помилка входу через Google');
                            })
                            .catch(function() { showError('Сталася помилка Google'); });
                        };

                        document.getElementById('btn-google-login').addEventListener('click', function() {
                            if (window.google && google.accounts) {
                                google.accounts.id.prompt();
                            }
                        });
                        {% endif %}

                        {% if facebook_app_id %}
                        // Facebook
                        document.getElementById('btn-facebook-login').addEventListener('click', function() {
                            FB.login(function(response) {
                                if (response.authResponse) {
                                    fetch('index.php?route=common/user_popup/facebookLogin', {
                                        method: 'POST',
                                        body: new URLSearchParams({ access_token: response.authResponse.accessToken }),
                                        credentials: 'same-origin'
                                    })
                                    .then(function(r) { return r.json(); })
                                    .then(function(json) {
                                        if (json.success) window.location.href = json.redirect;
                                        else showError(json.error || 'Помилка входу через Facebook');
                                    })
                                    .catch(function() { showError('Сталася помилка Facebook'); });
                                }
                            }, { scope: 'email' });
                        });
                        {% endif %}
                    })();
                    </script>
                </div>

                {# ===== РЕЄСТРАЦІЯ (по коду на email) ===== #}
                <div class="userPopup__result" data-userPopup-result="register">
                    <form id="popup-register-form" class="userPopup__form otp-form" data-otp-type="register" data-verify-label="{{ text_verify }}">
                        <input type="hidden" name="redirect" value="" data-popup-redirect>
                        <div class="userPopup__form-box otp-step-fields">
                            <div class="userPopup__form-item">
                                <input class="userPopup__form-input" type="text" name="firstname" placeholder="{{ text_firstname }}*" required>
                            </div>
                            <div class="userPopup__form-item">
                                <input class="userPopup__form-input" type="text" name="lastname" placeholder="{{ text_lastname }}">
                            </div>
                            <div class="userPopup__form-item">
                                <input class="userPopup__form-input" type="tel" name="telephone" placeholder="{{ text_telephone }}*" required>
                            </div>
                            <div class="userPopup__form-item otp-email-item">
                                <input class="userPopup__form-input" type="email" name="email" placeholder="Email*" required>
                                <span class="otp-email-check" aria-hidden="true"></span>
                            </div>
                        </div>

                        <div class="userPopup__code otp-step-code" hidden>
                            <p class="userPopup__code-note">{{ text_code_sent }} <b class="otp-email-label"></b></p>
                            <div class="userPopup__form-item">
                                <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="userPopup__form-input otp-code-input" placeholder="{{ text_code_placeholder }}">
                            </div>
                            <button type="button" class="userPopup__code-resend otp-resend">{{ text_code_resend }} <span class="otp-timer"></span></button>
                        </div>

                        <label class="userPopup__form-checkbox checkbox-block otp-agree-row">
                            <input type="checkbox" name="agree" value="1" class="visually-hidden" checked required>
                            <span>{{ text_agree }}</span>
                        </label>

                        <div class="userPopup__form-error otp-error" style="display:none;"></div>
                        <div class="userPopup__code-success otp-success" hidden></div>

                        <button class="userPopup__form-btn btn otp-submit" type="submit">{{ text_get_code }}</button>

                        <div class="userPopup__form-more"><span></span> {{ text_or }} <span></span></div>

                        <div class="userPopup__form-buttons">
                            {% if google_client_id %}
                                <button type="button" class="userPopup__form-log btn-2" id="btn-google-register">{{ button_google }}</button>
                            {% else %}
                                <button type="button" class="userPopup__form-log btn-2" disabled title="{{ text_google_oauth_off }}">{{ button_google }}</button>
                            {% endif %}
                            {% if facebook_app_id %}
                                <button type="button" class="userPopup__form-log btn-2" id="btn-facebook-register">{{ button_facebook }}</button>
                            {% else %}
                                <button type="button" class="userPopup__form-log btn-2" disabled title="{{ text_fb_oauth_off }}">{{ button_facebook }}</button>
                            {% endif %}
                        </div>
                    </form>

                    <script>
                    (function() {
                        const form    = document.getElementById('popup-register-form');
                        const errorEl = form.querySelector('.otp-error');
                        function showError(msg) { errorEl.textContent = msg; errorEl.style.display = 'block'; }
                        function clearError() { errorEl.textContent = ''; errorEl.style.display = 'none'; }
                        // страховка від нативного GET-сабміту, поки OTP не забіндився
                        form.addEventListener('submit', function (e) { if (!form.dataset.otpBound) e.preventDefault(); });
                        function bindOtp() {
                            if (window.ShokeruOtp) window.ShokeruOtp.init(form, { showError: showError, clearError: clearError, agreeError: '{{ error_agree }}' });
                        }
                        // common.js підключений з defer — чекаємо DOMContentLoaded
                        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindOtp);
                        else bindOtp();
                    })();
                    </script>
                </div>
            </div>
        </div>
    </div>
</section>

{% if google_client_id %}
<script src="https://accounts.google.com/gsi/client" async defer></script>
<div id="g_id_onload"
     data-client_id="{{ google_client_id }}"
     data-callback="handleGoogleCredential"
     data-auto_prompt="false">
</div>
{% endif %}

{% if facebook_app_id %}
<script>
window.fbAsyncInit = function() {
    FB.init({ appId: '{{ facebook_app_id }}', cookie: true, xfbml: true, version: 'v19.0' });
};
(function(d,s,id){
    var js, fjs = d.getElementsByTagName(s)[0];
    if (d.getElementById(id)) return;
    js = d.createElement(s); js.id = id;
    js.src = 'https://connect.facebook.net/uk_UA/sdk.js';
    fjs.parentNode.insertBefore(js, fjs);
}(document, 'script', 'facebook-jssdk'));
</script>
{% endif %}

<section class="userData" data-userData="password-recovery">
    <div class="container">
        <div class="userData__inner">
            <button class="userData__close">
                {{ text_close }}
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <rect x="9" y="28.7991" width="28" height="4" transform="rotate(-45 9 28.7991)" fill="#202222"/>
                    <rect x="28.8008" y="31.6274" width="9" height="4" transform="rotate(-135 28.8008 31.6274)" fill="#202222"/>
                    <rect x="11.8281" y="9" width="9" height="4" transform="rotate(45 11.8281 9)" fill="#202222"/>
                </svg>
            </button>
                    <div class="userData__info">
                        <div class="userData__info-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="33" height="36" viewBox="0 0 33 36" fill="none">
                                <path d="M6.1 14.6V6.1C6.1 4.7474 6.63732 3.45019 7.59376 2.49376C8.55019 1.53732 9.8474 1 11.2 1H21.4C22.7526 1 24.0498 1.53732 25.0062 2.49376C25.9627 3.45019 26.5 4.7474 26.5 6.1V7.8M4.4 14.6H28.2C30.0778 14.6 31.6 16.1222 31.6 18V31.6C31.6 33.4778 30.0778 35 28.2 35H4.4C2.52223 35 1 33.4778 1 31.6V18C1 16.1222 2.52223 14.6 4.4 14.6Z" stroke="#202222" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"/>
                                <circle cx="16.3013" cy="24.9656" r="1.49268" fill="#202222"/>
                                <circle cx="11.3247" cy="24.9656" r="1.49268" fill="#202222"/>
                                <circle cx="21.2739" cy="24.9656" r="1.49268" fill="#202222"/>
                            </svg>
                        </div>
                        <div class="userData__info-content">
                            <h2 class="userData__info-title">{{ text_forgot }}</h2>
                            <p class="userData__info-descr">{{ text_forgot_notice }}</p>
                        </div>
                    </div>
                    <form id="popup-forgotten-form" class="userData__form form-block">
                        <div class="userData__form-item">
                            <input class="userData__form-input form-input" type="email" name="email" placeholder="Email*" required>
                        </div>
                        <div class="userPopup__form-error forgotten-error" style="display:none;"></div>
                        <div class="userPopup__code-success forgotten-success" hidden></div>
                        <button class="userData__form-btn btn" type="submit">{{ button_recover }}</button>
                    </form>
                    <script>
                    (function () {
                        var form = document.getElementById('popup-forgotten-form');
                        if (!form) return;
                        var errorEl = form.querySelector('.forgotten-error');
                        var okEl    = form.querySelector('.forgotten-success');
                        var btn     = form.querySelector('button[type="submit"]');
                        var item    = form.querySelector('.userData__form-item');
                        form.addEventListener('submit', function (e) {
                            e.preventDefault();
                            errorEl.style.display = 'none'; errorEl.textContent = '';
                            btn.disabled = true;
                            fetch('index.php?route=common/user_popup/forgotten', { method: 'POST', body: new FormData(form), credentials: 'same-origin' })
                                .then(function (r) { return r.json(); })
                                .then(function (j) {
                                    btn.disabled = false;
                                    if (j.success) {
                                        if (item) item.style.display = 'none';
                                        btn.style.display = 'none';
                                        if (okEl) { okEl.hidden = false; okEl.textContent = j.message || 'Готово'; }
                                    } else {
                                        errorEl.textContent = j.error || 'Помилка'; errorEl.style.display = 'block';
                                    }
                                })
                                .catch(function () { btn.disabled = false; errorEl.textContent = 'Сталася помилка, спробуйте ще раз'; errorEl.style.display = 'block'; });
                        });
                    })();
                    </script>
       </div>
    </div>
</section>

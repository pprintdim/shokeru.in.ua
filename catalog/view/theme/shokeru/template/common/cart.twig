<section id="cart" class="busket" role="dialog" aria-modal="true" aria-label="{{ text_shopping_cart|e('html_attr') }}" data-cart-products="{{ cart_product_ids|json_encode|e('html_attr') }}">
    <div class="busket__inner">
        <div class="busket__top">
            <h2 class="busket__title">{{ text_items }}</h2>
            <button type="button" class="busket__close" aria-label="{{ text_close|e('html_attr') }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <rect x="9" y="28.7988" width="28" height="4" transform="rotate(-45 9 28.7988)" fill="#202222"/>
                    <rect x="28.7988" y="31.627" width="9" height="4" transform="rotate(-135 28.7988 31.627)" fill="#202222"/>
                    <rect x="11.8281" y="9" width="9" height="4" transform="rotate(45 11.8281 9)" fill="#202222"/>
                </svg>
            </button>
        </div>
        {% if products %}

            <div class="busket__block">

                {% for product in products %}
                    <div class="busket__item" data-cart-id="{{ product.cart_id }}" data-product-id="{{ product.product_id }}" data-ga4-name="{{ product.name|e('html_attr') }}" data-ga4-price="{{ product.ga4_price }}" data-ga4-quantity="{{ product.quantity }}">
                        <a class="busket__item-image" href="{{ product.href }}">
                            <img src="{{ product.thumb }}" alt="">
                        </a>
                        <div class="busket__item-content">
                            <a class="busket__item-title" href="{{ product.href }}">
                                <h3>{{ product.name }}</h3>
                            </a>

                            <p class="busket__item-price">
                                {% if product.special %}
                                    <span class="price-old">{{ product.price }}</span> 
                                {% endif %}
                                {{ product.special ?: product.price }}
                            </p>
                            <div class="busket__qty" data-cart-qty data-cart-id="{{ product.cart_id }}" data-qty="{{ product.quantity }}" role="group" aria-label="{{ text_quantity|e('html_attr') }}">
                                <button type="button" class="busket__qty-btn" data-qty-step="-1" aria-label="{{ text_qty_minus|e('html_attr') }}"{% if product.quantity <= 1 %} disabled{% endif %}>&minus;</button>
                                <span class="busket__qty-val" aria-live="polite">{{ product.quantity }}</span>
                                <button type="button" class="busket__qty-btn" data-qty-step="1" aria-label="{{ text_qty_plus|e('html_attr') }}">+</button>
                            </div>
                            <button type="button" onclick="cart.remove({{ product.cart_id }});" class="busket__item-delete" aria-label="{{ text_remove|e('html_attr') }}: {{ product.name|e('html_attr') }}"></button>
                        </div>
                    </div>
                {% endfor %}

            </div>


            <div class="busket__bottom">
                {% for total in totals %}
                    <div class="busket__bottom-item">
                        <p class="busket__bottom-descr">{{ total.title }}</p>
                        <p class="busket__bottom-descr">{{ total.text }}</p>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="busket__block">
                <p style="padding-left: 20px;display: block;">{{ text_empty }}</p>
            </div>
        {% endif %}
        <div class="busket__buttons">
            <a class="busket__btn btn-3" href="{{ cart }}">{{ text_cart }}</a>
            <a class="busket__btn btn-4" href="{{ products ? checkout : home }}">{{ products ? text_checkout : text_home }}</a>
        </div>
    </div>
</section>

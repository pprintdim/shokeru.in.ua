{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" class="btn btn-primary" data-toggle="tooltip" title="{{ button_save }}">
          <i class="fa fa-save"></i>
        </button>
        <a href="{{ cancel }}" class="btn btn-default" data-toggle="tooltip" title="{{ button_cancel }}">
          <i class="fa fa-reply"></i>
        </a>
      </div>

      <h1>{{ heading_title }}</h1>

      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger">{{ error_warning }}</div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>

      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" class="form-control" />
              {% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" class="form-control">
                <option value="1" {{ status ? 'selected' : '' }}>{{ text_enabled }}</option>
                <option value="0" {{ not status ? 'selected' : '' }}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <hr>

          <fieldset>
            <legend>
              Акції (банери)
              <small class="text-muted" style="font-weight:normal;">— на сторінці показується <b>випадкова</b> з увімкнених при кожному завантаженні</small>
            </legend>

            <div id="banner-rows">
              {% for i, banner in banners %}
              <div class="well well-sm banner-row">
                <div class="row">
                  <div class="col-sm-2 text-center">
                    <a href="" id="thumb-banner-{{ i }}" data-toggle="image" class="img-thumbnail">
                      <img src="{{ banner.thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" />
                    </a>
                    <input type="hidden" name="banners[{{ i }}][image]" value="{{ banner.image }}" id="input-banner-{{ i }}" />
                    <div style="margin-top:8px;">
                      <label style="font-weight:normal;font-size:12px;">
                        <input type="checkbox" name="banners[{{ i }}][status]" value="1" {{ banner.status ? 'checked' : '' }} /> {{ text_enabled }}
                      </label>
                    </div>
                  </div>

                  <div class="col-sm-9">
                    {% for language in languages %}
                    <div class="form-group" style="margin-bottom:8px;">
                      <label class="col-sm-3 control-label" style="padding-top:6px;">
                        <img src="language/{{ language.code }}/{{ language.code }}.png" alt="{{ language.name }}" /> {{ entry_title }}
                      </label>
                      <div class="col-sm-9">
                        <input type="text" name="banners[{{ i }}][title][{{ language.language_id }}]" value="{{ banner.title[language.language_id] ?? '' }}" placeholder="{{ entry_title }}" class="form-control" />
                      </div>
                    </div>
                    <div class="form-group" style="margin-bottom:8px;">
                      <label class="col-sm-3 control-label" style="padding-top:6px;">
                        <img src="language/{{ language.code }}/{{ language.code }}.png" alt="{{ language.name }}" /> {{ entry_description }}
                      </label>
                      <div class="col-sm-9">
                        <textarea name="banners[{{ i }}][description][{{ language.language_id }}]" rows="2" placeholder="{{ entry_description }}" class="form-control">{{ banner.description[language.language_id] ?? '' }}</textarea>
                      </div>
                    </div>
                    {% endfor %}
                  </div>

                  <div class="col-sm-1 text-right">
                    <button type="button" class="btn btn-danger btn-remove-banner">
                      <i class="fa fa-minus-circle"></i>
                    </button>
                  </div>
                </div>
              </div>
              {% endfor %}
            </div>

            <div class="text-right">
              <button type="button" id="btn-add-banner" class="btn btn-primary">
                <i class="fa fa-plus-circle"></i> Додати акцію
              </button>
            </div>
          </fieldset>

        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
var bannerIndex = {{ banners|length }};
var langs = {{ languages_json|raw }};
var placeholderImg = '{{ placeholder }}';
var textEnabled = '{{ text_enabled }}';
var entryTitle = '{{ entry_title }}';
var entryDescr = '{{ entry_description }}';

function bannerRowHtml(i) {
  var langHtml = '';

  langs.forEach(function (l) {
    langHtml +=
      '<div class="form-group" style="margin-bottom:8px;">' +
        '<label class="col-sm-3 control-label" style="padding-top:6px;"><img src="language/' + l.code + '/' + l.code + '.png" alt="' + l.name + '" /> ' + entryTitle + '</label>' +
        '<div class="col-sm-9"><input type="text" name="banners[' + i + '][title][' + l.language_id + ']" value="" placeholder="' + entryTitle + '" class="form-control" /></div>' +
      '</div>' +
      '<div class="form-group" style="margin-bottom:8px;">' +
        '<label class="col-sm-3 control-label" style="padding-top:6px;"><img src="language/' + l.code + '/' + l.code + '.png" alt="' + l.name + '" /> ' + entryDescr + '</label>' +
        '<div class="col-sm-9"><textarea name="banners[' + i + '][description][' + l.language_id + ']" rows="2" placeholder="' + entryDescr + '" class="form-control"></textarea></div>' +
      '</div>';
  });

  return '<div class="well well-sm banner-row">' +
    '<div class="row">' +
      '<div class="col-sm-2 text-center">' +
        '<a href="" id="thumb-banner-' + i + '" data-toggle="image" class="img-thumbnail">' +
          '<img src="' + placeholderImg + '" alt="" title="" data-placeholder="' + placeholderImg + '" />' +
        '</a>' +
        '<input type="hidden" name="banners[' + i + '][image]" value="" id="input-banner-' + i + '" />' +
        '<div style="margin-top:8px;"><label style="font-weight:normal;font-size:12px;">' +
          '<input type="checkbox" name="banners[' + i + '][status]" value="1" checked /> ' + textEnabled +
        '</label></div>' +
      '</div>' +
      '<div class="col-sm-9">' + langHtml + '</div>' +
      '<div class="col-sm-1 text-right">' +
        '<button type="button" class="btn btn-danger btn-remove-banner"><i class="fa fa-minus-circle"></i></button>' +
      '</div>' +
    '</div>' +
  '</div>';
}

$('#btn-add-banner').on('click', function () {
  $('#banner-rows').append(bannerRowHtml(bannerIndex));
  bannerIndex++;
});

$('#banner-rows').on('click', '.btn-remove-banner', function () {
  $(this).closest('.banner-row').remove();
});
//--></script>
{{ footer }}

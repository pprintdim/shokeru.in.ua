{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-merchant">{{ entry_merchant }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_wayforpay_merchant" value="{{ payment_wayforpay_merchant }}" id="input-merchant" class="form-control" />
            </div>
          </div>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-secretkey">{{ entry_secretkey }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_wayforpay_secretkey" value="{{ payment_wayforpay_secretkey }}" id="input-secretkey" class="form-control" />
            </div>
          </div>
          {% for language in languages %}
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_title }} ({{ language.name }})</label>
            <div class="col-sm-10">
              <input type="text" name="payment_wayforpay_title{{ language.language_id }}" value="{{ attribute(_context, 'payment_wayforpay_title' ~ language.language_id) }}" class="form-control" />
            </div>
          </div>
          {% endfor %}
          {# до оплати замовлення не має отримувати робочий статус: інакше
             воно виглядає як успішне ще до того, як гроші пішли #}
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-pending-status">{{ entry_pending_status|default('Статус до оплати') }}</label>
            <div class="col-sm-10">
              <select name="payment_wayforpay_pending_status_id" id="input-pending-status" class="form-control">
                {% for order_status in order_statuses %}
                <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_wayforpay_pending_status_id %} selected="selected"{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
              <div class="help-block">{{ help_pending_status|default('Ставиться одразу після оформлення, поки оплата не підтверджена.') }}</div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-order-status">{{ entry_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_wayforpay_order_status_id" id="input-order-status" class="form-control">
                {% for order_status in order_statuses %}
                <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_wayforpay_order_status_id %} selected="selected"{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-decline-status">{{ entry_decline_status }}</label>
            <div class="col-sm-10">
              <select name="payment_wayforpay_decline_status_id" id="input-decline-status" class="form-control">
                {% for order_status in order_statuses %}
                <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_wayforpay_decline_status_id %} selected="selected"{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-cancel-status">{{ entry_cancel_status }}</label>
            <div class="col-sm-10">
              <select name="payment_wayforpay_cancel_status_id" id="input-cancel-status" class="form-control">
                {% for order_status in order_statuses %}
                <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_wayforpay_cancel_status_id %} selected="selected"{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-total">{{ entry_total }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_wayforpay_total" value="{{ payment_wayforpay_total }}" id="input-total" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="payment_wayforpay_geo_zone_id" id="input-geo-zone" class="form-control">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_wayforpay_geo_zone_id %} selected="selected"{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="payment_wayforpay_status" id="input-status" class="form-control">
                {% if payment_wayforpay_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_wayforpay_sort_order" value="{{ payment_wayforpay_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
